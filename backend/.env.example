GENERATION_ENGINE=mock
# Set these only when GENERATION_ENGINE=remote_flux.
# FLUX_REMOTE_URL=https://your-session.trycloudflare.com
# FLUX_REMOTE_API_KEY=your-shared-key-from-Kaggle-Secret
# Optional dual-adapter demo; omit to keep the three TRAIN-001 styles.
# HAIRCAPSTONE_STYLE_REGISTRY_PATH=F:/HAIR/backend/app/style_registry_train002_smoke.json
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Independent Makeup service. These do not change Hair's engine or URL.
MAKEUP_GENERATION_ENGINE=mock
# MAKEUP_GENERATION_ENGINE=remote_makeup
# MAKEUP_REMOTE_URL=https://your-makeup-session.trycloudflare.com
# MAKEUP_REMOTE_API_KEY=<same value as Kaggle MAKEUP001_API_KEY Secret, at least 24 characters>
# Nails hybrid route. The segmentation interpreter stays isolated from Hair/Makeup.
# NAILS_PREVIEW_MODE=hybrid
# NAILS_HAND_LANDMARKER_PATH=F:/HAIR/data/nails/checkpoints/mediapipe/hand_landmarker.task
# NAILS_SEGMENT_PYTHON=F:/HAIR/data/nails/work/seg-venv/Scripts/python.exe
# NAILS_SEGMENT_CHECKPOINT=F:/HAIR/data/nails/checkpoints/mnemic/nails_seg_s_yolov8_v1.pt
# Red and Black need a live Kaggle GPU service; the other three styles are local.
# NAILS_REMOTE_URL=https://your-nails-session.trycloudflare.com
# NAILS_REMOTE_API_KEY=<same value as Kaggle NAILS001_API_KEY Secret, at least 24 characters>
